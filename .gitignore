# 虚拟环境目录，彻底忽略整个文件夹
.venv/
venv/

# 密钥环境文件（重中之重）
.env
.env.local
.env.*
# 保留模板文件供他人参考（不被 .env.* 忽略）
!.env.example

# Python字节码缓存
__pycache__/
*.pyc
*.pyo
*.pyd

# Python 测试/类型检查/构建缓存
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.pyright/
.ruff_cache/
.tox/
.nox/
*.egg-info/
build/

# pytest 缓存（可重建，不入库；且本机该目录 ACL 异常会导致 git/IDE 枚举报 Permission denied）
.pytest_cache/
pytest_cache/

# 日志文件
*.log
streamlit*.log
uvicorn*.log

# SQLite数据库文件
*.db
*.db-shm
*.db-wal

# 上传资源、运行产生的临时文件
resources/uploads/
resources/checkpoint*
# 菜品图缓存（运行时生成、可重建，不入库）
resources/dish_image_cache.json

# 用户个人偏好（含忌口/健康约束等隐私数据，不入库）
data/preferences.txt
# 保留公开模板供他人参考（不被上面的规则忽略）
!data/preferences.txt.example

# UV依赖锁定文件其实可以保留（可选）
# uv.lock
# pyproject.toml

# 系统文件
.DS_Store
.Thumbs.db

# IDE配置文件
.idea/

# 运行时会话数据（用户对话历史，含隐私，不入库）
sessions/

# 智能体项目记忆（WorkBuddy 内部数据，不入库）
.workbuddy/

# 开发/测试用的临时图片（非项目必要资源）
t_veg.jpg
test_veg2.jpg

# OSS 清理过程产生的本地备份和删除计划（不属于应用运行时）
oss_backup_*/
oss_delete_plan.json

# RAG 向量索引、清洗预览、SQLite 和编辑备份（可重建，不入库）
kb/chroma/
kb_corpus_chroma/
resources/cleaned_preview/
*.sqlite3
*.bak
*.bak_*

# 本地模型缓存（HuggingFace 下载，体积大，可重建，不入库）
.hf_cache/

# RAG 原始语料 PDF（官方食养指南/国标，体积大且可外部获取，本地保留、不入库）
kb/**/*.pdf
kb_corpus/
# 尚未整理入库的本地附件，可能包含个人文件或外部受版权约束的原始材料
kb/_未入库/

# 前端依赖与构建产物
node_modules/
dist/

# 本地 API Key 配置（含密钥，禁止入库）
配置key.md

# TypeScript 增量编译缓存
*.tsbuildinfo

# 本地模型缓存（bge / reranker，体积大可重建）
models/

# Agent 运行期追踪文件（本地调试数据，不是源码）
agent/data/agent_trace.jsonl

# 会话内临时探针脚本与产物
.tmp-*
root_probe/

# 运行态状态（checkpoint 数据库与本地缓存）
resources/

# 用户本地饮食数据与 Playwright 临时下载缓存
data/fridge.json
data/meals.json
data/pantry_log.json
data/agent_trace.jsonl
data/feedback.json
data/profile.json
.npm-cache-playwright/

# 配图分流判断门测试（AI 临时验证测试，按用户要求不入库）
tests/test_image_gating.py
tests/**/test_image_gating.py

# 前端构建缓存（之前误提交，应忽略，可重建）
frontend/web/.vite-cache/

# 运行态用户数据（反馈/口味/周报/菜品资源/PDF目录映射，含隐私或可重建，不入库）
data/answer_feedback.json
data/taste_signals.json
data/weekly_summary.json
data/dish_assets.json
data/toc_map.json

# --------------------------------------------------------------------------- #
# 以下为「本地工具 / 运行期产物」隔离规则（2026-09-19 补）
# 起因：一次 git add -A 把 45 个 .tmpdir 调试产物 + 8 个 .corepack 运行时文件
# 混进了提交。协作项目里这类文件会让协作者 clone 到一堆无用内容、并在 diff 里长期闪。
# --------------------------------------------------------------------------- #

# pnpm 运行时（corepack 自动下载，体积大且机器相关，不入库）
.corepack/

# 会话内临时探针脚本与产物（调试专用，不入库）
.tmpdir/

# 逐轮 token 用量日志（运行期累积，与 agent_trace.jsonl 同类，不入库）
data/usage.jsonl

# 三层健康记忆的候选池（含成员过敏原等隐私，不入库）
data/memory_candidates.json

# 本地调试启动脚本（写死本机路径/端口，协作者无意义，不入库）
start_deepseek_harness.cmd

# 浏览器自动化和测试运行产物
playwright-report/
test-results/

# 实验/基准运行生成的结果文件；实验脚本和可复现的输入数据仍保留
experiments/*_result.csv
benchmarks/*comparison*.csv
benchmarks/*comparison*.json
benchmarks/recall.latest.json

# 编辑器、补丁和临时交换文件
*.swp
*.swo
*.orig
*.rej
*.tmp

# --------------------------------------------------------------------------- #
# ⚠️ 目录重构后的运行数据路径（2026-09-23 补）
# 起因：项目做了分层重构（agent/ domain/ infrastructure/ services/ storage/ scripts/），
# 运行数据目录随之搬家。上面那些 data/xxx.json 规则是「相对仓库根目录」的精确路径
# （gitignore 中带斜杠的模式不跨层级匹配），因此**匹配不到** storage/data/、agent/data/
# 等新位置 —— 实测 storage/data/memory_candidates.json（含真实过敏原隐私）
# 与 agent/data/usage.jsonl 仍会被 git 提交。
#
# 注意：`sessions/`（结尾带斜杠、中间无斜杠）会跨层级匹配，所以 storage/sessions/ 已被拦住；
# `*.log` / `*.bak` / `__pycache__/` 同理，均已安全。
# --------------------------------------------------------------------------- #
storage/data/
agent/data/
domain/data/
infrastructure/data/
