# 虚拟环境目录，彻底忽略整个文件夹
.venv/
venv/

# 密钥环境文件（重中之重）
.env
.env.local
.env.*
# 保留模板文件供他人参考（不被 .env.* 忽略）
!.env.example

# Python字节码缓存
__pycache__/
*.pyc
*.pyo
*.pyd

# 日志文件
*.log
streamlit*.log
uvicorn*.log

# SQLite数据库文件
*.db
*.db-shm
*.db-wal

# 上传资源、运行产生的临时文件
resources/uploads/
resources/checkpoint*
# 菜品图缓存（运行时生成、可重建，不入库）
resources/dish_image_cache.json

# 用户个人偏好（含忌口/健康约束等隐私数据，不入库）
data/preferences.txt
# 保留公开模板供他人参考（不被上面的规则忽略）
!data/preferences.txt.example

# UV依赖锁定文件其实可以保留（可选）
# uv.lock
# pyproject.toml

# 系统文件
.DS_Store
.Thumbs.db

# IDE配置文件
.idea/

# 运行时会话数据（用户对话历史，含隐私，不入库）
sessions/

# 智能体项目记忆（WorkBuddy 内部数据，不入库）
.workbuddy/

# 开发/测试用的临时图片（非项目必要资源）
t_veg.jpg
test_veg2.jpg

# OSS 清理过程产生的本地备份和删除计划（不属于应用运行时）
oss_backup_*/
oss_delete_plan.json

# RAG 向量索引、清洗预览、SQLite 和编辑备份（可重建，不入库）
kb/chroma/
kb_corpus_chroma/
resources/cleaned_preview/
*.sqlite3
*.bak_*

# 本地模型缓存（HuggingFace 下载，体积大，可重建，不入库）
.hf_cache/

# RAG 原始语料 PDF（官方食养指南/国标，体积大且可外部获取，本地保留、不入库）
kb/**/*.pdf
kb_corpus/

# 前端依赖与构建产物
node_modules/
dist/

# 本地 API Key 配置（含密钥，禁止入库）
配置key.md

# TypeScript 增量编译缓存
*.tsbuildinfo

# 本地模型缓存（bge / reranker，体积大可重建）
models/

# 会话内临时探针脚本与产物
.tmp-*
