# 虚拟环境目录，彻底忽略整个文件夹
.venv/
venv/

# 密钥环境文件（重中之重）
.env
.env.local
.env.*
# 保留模板文件供他人参考（不被 .env.* 忽略）
!.env.example

# Python字节码缓存
__pycache__/
*.pyc
*.pyo
*.pyd

# 日志文件
*.log
streamlit*.log
uvicorn*.log

# SQLite数据库文件
*.db
*.db-shm
*.db-wal

# 上传资源、运行产生的临时文件
resources/uploads/
resources/checkpoint*
# 菜品图缓存（运行时生成、可重建，不入库）
resources/dish_image_cache.json

# UV依赖锁定文件其实可以保留（可选）
# uv.lock
# pyproject.toml

# 系统文件
.DS_Store
.Thumbs.db

# IDE配置文件
.idea/

# 运行时会话数据（用户对话历史，含隐私，不入库）
sessions/

# 智能体项目记忆（WorkBuddy 内部数据，不入库）
.workbuddy/

# 开发/测试用的临时图片（非项目必要资源）
t_veg.jpg
test_veg2.jpg