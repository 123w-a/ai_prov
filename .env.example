# ===== 大模型（聊天必需：至少配置一个 provider）=====
# 二选一，推荐 DeepSeek（便宜）：https://platform.deepseek.com 创建 API Key
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODE_NAME=deepseek-chat
# 摘要/历史压缩专用模型：需使用稳定返回正文的模型，避免正文只留在 reasoning_content
SUMMARY_MODE_NAME=deepseek-chat

# OpenAI 兼容接口（官方 OpenAI / 任何中转站都可以）：
# CHAT_API_KEY=
# CHAT_BASE_URL=
# CHAT_MODE_NAME=

# 指定用哪个主脑模型：gpt / deepseek；不写则自动选第一个配好 Key 的
# CHEF_PROVIDER=deepseek

# 结构化整理节点的思考开关（仅对 deepseek 生效）：默认 off。
# 该端点把 reasoning token 计进 max_tokens，2048 预算下思考会吃光预算、正文为空，
# ChefAnswer 解析失败后全量重跑；整理节点只做格式整理，关掉不牺牲安全判定。
# STRUCTURE_THINKING=off

# 结构化整理节点用哪个模型；不写则沿用主脑。
# 实测：跟着主脑（gpt）走时该节点 86s，超过客户端 75s 超时 → 被切断并整轮重跑，
# 时间直接翻倍；钉到 deepseek 后同一节点 9.6s（thinking 已关，只做格式整理）。
# 前提是该 provider 已配好 Key；没有就删掉这两行，回落到主脑。
# STRUCTURE_PROVIDER=deepseek
# STRUCTURE_MODEL_NAME=deepseek-v4-pro

# ===== 视觉模型（独立于主脑，推荐 Qwen3-VL / 阿里云百炼）=====
# 复用 DASHSCOPE_API_KEY；也可单独提供 QWEN_API_KEY。
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODE_NAME=qwen3-vl-235b-a22b-instruct
VISION_PROVIDER=qwen
VISION_MODEL_NAME=qwen3-vl-235b-a22b-instruct

# ===== 语音识别（阿里云百炼 / DashScope 录音文件识别）=====
# 仅做“录音文件识别”（非实时流式），先把能演示、能落地的版本做出来。
SPEECH_PROVIDER=dashscope
SPEECH_MODEL=paraformer-v2
SPEECH_MAX_MB=10
SPEECH_LANGUAGE_HINTS=zh,en

# 阿里云百炼 / 通义万相 API Key（语音识别 + AI 生图共用）
# 申请：https://dashscope.console.aliyun.com/  → 创建 API Key
# 留空则语音识别返回 503（明确提示“暂未配置”），不影响其它功能。
DASHSCOPE_API_KEY=

# ===== AI 菜品生图策略（可选）=====
# 默认 turbo 优先保证稳定和响应速度；确需更精细时可显式改为 wanx2.1-t2i-plus。
WANX_MODEL=wanx2.1-t2i-turbo
# 单次生图超时、视觉验收超时，以及首图失败后最多一次纠错重生成的总预算。
# 实测 turbo 档常有 >20s 的生成（日志「通义万相生成超时（>20.0s），放弃本次生成」），
# 20s 会把生成砍断——结果不是「图慢一点」，而是这道菜直接没有图。40s 显著提高出图率；
# 配合候选轮图片预热，用户在候选清单停留的时间通常足够跑完。
WANX_TIMEOUT_S=40
IMAGE_QUALITY_ENABLED=1
IMAGE_QUALITY_TIMEOUT_S=8
IMAGE_GENERATION_BUDGET_S=45
# 纠错重生成至少要留出的时间窗（秒）；剩余预算不足时直接用首图，不再同步等第二次生图。
IMAGE_STRICT_RETRY_MIN_S=12
# 实时补图线程的总预算与 SSE 等待上限（秒）。前者要小于后者，
# 否则多菜轮次里第一道冷启动生图会把后面的菜整轮跳过。
CHEF_IMAGE_THREAD_BUDGET_S=120
CHEF_IMAGE_THREAD_MAX_WAIT_S=180

# ===== Tavily 联网搜索（菜谱 / 成品图检索，必需）=====
# 申请：https://tavily.com  → 注册后创建 API Key（免费额度足够 demo 使用）
# 必须配置：未配置时后端在 import 阶段就会报错，无法启动。
TAVILY_API_KEY=

# ===== 阿里云 OSS（图片上传，可选：不配则图片相关功能不可用）=====
# 申请：https://oss.console.aliyun.com/  → 创建 Bucket，并配置 AccessKey
# OSS_ENDPOINT=
# OSS_BUCKET=
# OSS_ACCESS_KEY=
# OSS_SECRET_KEY=
# OSS_BASE_URL=

# ===== 高德地图 Web 服务 Key（nearby_food 附近餐厅检索，可选）=====
# 申请：https://lbs.amap.com → 控制台 → 应用管理 → 创建应用 → 添加 Key（Web 服务）
# AMAP_KEY=

# ===== LlamaCloud 文档解析（PDF → RAG 语料，可选）=====
# LLAMA_CLOUD_API_KEY=

# ===== RAG 知识库（Chroma）位置与参数 =====
KB_DIR=kb/chroma
KB_CORPUS_DIR=kb
KB_COLLECTION=dietary_kb
KB_EMBEDDING=bge
KB_CHUNK_SIZE=1200
KB_CHUNK_OVERLAP=120
KB_PREVIEW_DIR=resources/cleaned_preview
# RAG 检索重排开关：开启后首次检索会自动下载 bge-reranker-v2-m3（模型较大）。
# 实测（CPU 推理）：开启时每次检索 22~26s，一轮两个工具要 181s（最差 376s）；
# 关闭后热态 0.0s、整轮 4.5~6.5s，且 39 条召回用例 recall=1.0（不降质）。
# 除非有 GPU 或确实需要重排精度，否则保持 0。
KB_ENABLE_RERANK=0

# ===== 日志目录（可选：不配则写到系统用户级目录，不进项目）=====
# 默认位置：
#   Windows  %LOCALAPPDATA%\XiaoShanGuanJia\logs
#   macOS    ~/Library/Logs/XiaoShanGuanJia
#   Linux    $XDG_STATE_HOME/xiaoshan-guanjia/logs
# 落到这里的文件：app.log、agent_trace.jsonl、usage.jsonl、allergen_unresolved.log
# 想换个盘（例如 D 盘）就填绝对路径，代码不用改：
# CHEF_LOG_DIR=D:\Cache\Logs\XiaoShanGuanJia

# ===== 前端环境变量（frontend/web/.env；不要写进根目录 .env）=====
# 首次运行前端时先复制模板：
#   PowerShell: Copy-Item frontend\web\.env.example frontend\web\.env
#   Bash:       cp frontend/web/.env.example frontend/web/.env
#
# 后端 API 基础地址：
#   留空 = 走 Vite 代理（开发推荐，/api -> http://127.0.0.1:8010）
#   直连后端 = http://127.0.0.1:8010
# VITE_API_BASE=
#
# 高德开放平台「Web端(JS API)」应用凭证：
#   与后端 POI 检索使用的 AMAP_KEY 不是同一种 Key，不能互相替代。
# VITE_AMAP_JS_KEY=
# VITE_AMAP_SECURITY_CODE=
