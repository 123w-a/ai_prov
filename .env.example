# 复制为 .env 并填入真实值（.env 已被 gitignore，不会上传）

# DeepSeek 模型
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODE_NAME=deepseek-chat

# 备用对话模型
CHAT_API_KEY=your_chat_api_key
CHAT_BASE_URL=https://api.your-chat-provider.com/v1
CHAT_MODE_NAME=your_chat_model

# 主脑模型选择（可选，默认 gpt）：deepseek / gpt
# 也可在 main.py 顶部改 PROVIDER 变量，二者取其一即可
CHEF_PROVIDER=gpt

# Tavily 搜索
TAVILY_API_KEY=your_tavily_api_key

# LangSmith 追踪（可选）
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=ai-chef-agent

# 阿里云 OSS（图片存储）
OSS_ENDPOINT=https://oss-cn-region.aliyuncs.com
OSS_BUCKET=your_bucket
OSS_ACCESS_KEY=your_access_key
OSS_SECRET_KEY=your_secret_key
OSS_BASE_URL=https://your_bucket.oss-cn-region.aliyuncs.com

# 通义万相 / 阿里云百炼 文生图（搜不到菜品图时自动生成「AI 示意图」兜底）
# 申请地址：阿里云百炼控制台 https://bailian.console.aliyun.com → 右上角「API Key」→ 创建
# 申请后把 sk-xxxx 填到下面一行（留空则功能自动降级，不影响其它功能）
DASHSCOPE_API_KEY=
# 可选：文生图模型。默认 wanx2.1-t2i-turbo（快且便宜）；想要更精致的成品照可改 wanx2.1-t2i-plus
WANX_MODEL=wanx2.1-t2i-turbo
