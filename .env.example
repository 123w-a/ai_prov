# 复制为 .env 并填入真实值（.env 已被 gitignore，不会上传）

# DeepSeek 模型
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODE_NAME=deepseek-chat

# 备用对话模型
CHAT_API_KEY=your_chat_api_key
CHAT_BASE_URL=https://api.your-chat-provider.com/v1
CHAT_MODE_NAME=your_chat_model

# Tavily 搜索
TAVILY_API_KEY=your_tavily_api_key

# LangSmith 追踪（可选）
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=ai-chef-agent

# 阿里云 OSS（图片存储）
OSS_ENDPOINT=https://oss-cn-region.aliyuncs.com
OSS_BUCKET=your_bucket
OSS_ACCESS_KEY=your_access_key
OSS_SECRET_KEY=your_secret_key
OSS_BASE_URL=https://your_bucket.oss-cn-region.aliyuncs.com
