ht: 1.5;\n}\n\n.dish-chip em {\n  font-style: normal;\n  font-weight: 700;\n  color: #2e7d50;\n}\n\n.light-pill {\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n  padding: 3px 10px;\n  border-radius: 999px;\n  font-size: 12px;\n  font-weight: 600;\n}\n\n.light-pill::before {\n  content: '';\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  background: currentColor;\n}\n\n.light-green {\n  color: #2e7d32;\n  background: rgba(46, 125, 50, 0.12);\n}\n\n.light-red {\n  color: #c62828;\n  background: rgba(198, 40, 40, 0.1);\n}\n\n.light-yellow,\n.light-amber {\n  color: #b26a00;\n  background: rgba(255, 167, 38, 0.16);\n}\n\n.report-range {\n  font-size: 11px;\n  opacity: 0.5;\n  text-align: right;\n}\n\n.block-label small {\n  margin-left: 4px;\n  font-size: 0.78em;\n  font-weight: 500;\n  opacity: 0.65;\n}\n\n.trend-pill {\n  display: inline-flex;\n  padding: 3px 8px;\n  border-radius: 6px;\n  font-size: 12px;\n  border: 1px solid var(--line);\n}\n\n.trend-improving {\n  color: #2e7d32;\n  background: rgba(46, 125, 50, 0.12);\n}\n\n.trend-worsening {\n  color: #b26a00;\n  background: rgba(255, 167, 38, 0.16);\n}\n\n.trend-stable {\n  color: var(--ink);\n  background: var(--paper-muted);\n}\n\n.trend-insufficient {\n  color: var(--ink-muted);\n  background: var(--paper-muted);\n}\n\n.recommendation-list {\n  margin: 6px 0 0;\n  padding-left: 18px;\n}\n\n.recommendation-list li {\n  margin-top: 4px;\n  font-size: 12px;\n  line-height: 1.5;\n}\n\n/* 拍照清点与用餐反馈（P0 双闭环） */\n.vision-row{display:flex;align-items:center;gap:8px;margin-top:8px;flex-wrap:wrap}\n.vision-row .tool-btn{width:auto;padding:6px 12px}\n.vision-draft{margin-top:8px;align-items:center}\n.vision-chip{display:inline-flex;align-items:center;gap:4px}\n.vision-chip button{border:none;background:none;cursor:pointer;font-size:12px;opacity:.6;padding:0 2px}\n.vision-chip button:hover{opacity:1}\n.meal-feedback{margin-top:12px;border-top:1px dashed rgba(0,0,0,.12);padding-top:10px}\n.feedbac