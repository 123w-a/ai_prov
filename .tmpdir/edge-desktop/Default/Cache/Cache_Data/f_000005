(45, 104, 77, 0.18);\n}\n\n.tool-btn.image-suggest-btn {\n  color: #7d5a12;\n  background: rgba(217, 166, 46, 0.12);\n  box-shadow: inset 0 0 0 1px rgba(217, 166, 46, 0.18);\n}\n\n.tool-btn.image-suggest-btn:hover:not(:disabled) {\n  color: #6c4f0d;\n  background: rgba(217, 166, 46, 0.18);\n}\n\n.tool-btn.recording {\n  color: var(--danger);\n  background: var(--danger-soft);\n  animation: recording-pulse 1.4s infinite;\n}\n\n.tool-btn.location-btn.locating {\n  color: #7a5d13;\n  background: rgba(217, 166, 46, 0.14);\n  box-shadow: inset 0 0 0 1px rgba(217, 166, 46, 0.22);\n}\n\n.tool-btn.location-btn.resolved {\n  color: var(--forest-800);\n  background: rgba(45, 104, 77, 0.12);\n  box-shadow: inset 0 0 0 1px rgba(45, 104, 77, 0.18);\n}\n\n.tool-btn.location-btn.gps {\n  color: #315d76;\n  background: rgba(77, 120, 144, 0.14);\n  box-shadow: inset 0 0 0 1px rgba(77, 120, 144, 0.18);\n}\n\n.tool-btn.location-btn.denied {\n  color: var(--ink-soft);\n  background: rgba(122, 138, 126, 0.12);\n  box-shadow: inset 0 0 0 1px rgba(122, 138, 126, 0.16);\n}\n\n@keyframes recording-pulse {\n  50% {\n    box-shadow: 0 0 0 5px rgba(185, 68, 55, 0.08);\n  }\n}\n\n.send-zone {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  justify-content: flex-end;\n  gap: 11px;\n}\n\n.send-zone > span {\n  color: var(--ink-faint);\n  font-size: 8px;\n}\n\n.send-btn {\n  display: inline-flex;\n  min-height: 36px;\n  align-items: center;\n  gap: 8px;\n  padding: 0 14px;\n  color: #fff;\n  border: 0;\n  border-radius: 11px;\n  background: var(--tomato);\n  box-shadow: 0 8px 18px rgba(227, 108, 67, 0.2);\n  font-size: 10px;\n  font-weight: 760;\n}\n\n.send-btn:hover:not(:disabled) {\n  background: var(--tomato-dark);\n  transform: translateY(-1px);\n}\n\n.send-btn:disabled {\n  opacity: 0.42;\n  box-shadow: none;\n}\n\n.composer-status {\n  width: min(760px, 100%);\n  min-height: 17px;\n  margin: 5px auto 0;\n  padding: 0 4px;\n  color: var(--ink-faint);\n  font-size: 7px;\n  line-height: 1.45;\n}\n\n/* Decision evidence rail */\n\n.insight-panel {\n  display: flex;\n  min-width: 0;\n  min-height: 0;\n  flex-direction: column;\n  overflow: hidden;\n  background: #ece9df;\n  border-left: 1px solid var(--line-strong);\n}\n\n.insight-header {\n  display: flex;\n  min-height: 68px;\n  flex: 0 0 auto;\n  align-items: center;\n  justify-content: space-between;\n  gap: 10px;\n  padding: 12px 17px;\n  background: rgba(255, 253, 248, 0.55);\n  border-bottom: 1px solid var(--line);\n}\n\n.insight-header h2 {\n  margin: 0;\n  font-family: \"Songti SC\", \"STSong\", ui-serif, serif;\n  font-size: 14px;\n}\n\n.trace-status {\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n  padding: 5px 8px;\n  color: var(--ink-faint);\n  border: 1px solid var(--line);\n  border-radius: 999px;\n  background: var(--paper);\n  font-size: 8px;\n  font-weight: 700;\n}\n\n.trace-status i {\n  width: 5px;\n  height: 5px;\n  background: var(--ink-faint);\n  border-radius: 50%;\n}\n\n.trace-status.ready {\n  color: var(--forest-700);\n  border-color: rgba(45, 104, 77, 0.16);\n  background: var(--forest-100);\n}\n\n.trace-status.ready i {\n  background: #55a36b;\n}\n\n.trace-empty {\n  display: flex;\n  min-height: 0;\n  flex: 1;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  padding: 28px 24px;\n  text-align: center;\n}\n\n.trace-orbit {\n  position: relative;\n  display: grid;\n  width: 82px;\n  height: 82px;\n  margin-bottom: 18px;\n  place-items: center;\n  color: var(--forest-700);\n  border: 1px solid rgba(45, 104, 77, 0.2);\n  border-radius: 50%;\n  background: var(--forest-100);\n}\n\n.trace-orbit::after {\n  position: absolute;\n  content: \"\";\n  border: 1px dashed rgba(45, 104, 77, 0.22);\n  border-radius: 50%;\n  inset: -8px;\n}\n\n.trace-empty h3 {\n  max-width: 230px;\n  margin: 0;\n  font-family: \"Songti SC\", \"STSong\", ui-serif, serif;\n  font-size: 18px;\n  line-height: 1.45;\n}\n\n.trace-empty > p {\n  margin: 10px 0 22px;\n  color: var(--ink-soft);\n  font-size: 10px;\n  line-height: 1.7;\n}\n\n.trace-steps {\n  display: grid;\n  width: 100%;\n  gap: 7px;\n  margin: 0;\n  padding: 0;\n  text-align: left;\n  list-style: none;\n}\n\n.trace-steps li {\n  display: flex;\n  align-items: center;\n  gap: 9px;\n  padding: 9px 10px;\n  color: var(--ink-soft);\n  border: 1px solid var(--line);\n  border-radius: 10px;\n  background: rgba(255, 253, 248, 0.55);\n  font-size: 9px;\n}\n\n.trace-steps span {\n  display: grid;\n  width: 21px;\n  height: 21px;\n  place-items: center;\n  color: var(--tomato-dark);\n  background: var(--tomato-soft);\n  border-radius: 50%;\n  font-family: ui-serif, Georgia, serif;\n  font-size: 8px;\n  font-weight: 800;\n}\n\n.insight-scroll {\n  min-height: 0;\n  padding: 17px;\n  overflow-y: auto;\n}\n\n.decision-summary {\n  display: grid;\n  gap: 11px;\n  padding: 15px 15px 14px;\n  margin-bottom: 18px;\n  color: #fffdf8;\n  background:\n    linear-gradient(180deg, rgba(23, 63, 46, 0.98), rgba(16, 43, 32, 0.98));\n  border: 1px solid rgba(143, 167, 124, 0.24);\n  border-radius: 14px;\n  box-shadow: 0 16px 30px rgba(16, 43, 32, 0.14);\n}\n\n.decision-summary-head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  font-size: 10px;\n  color: rgba(255, 253, 248, 0.72);\n}\n\n.decision-summary-head strong {\n  color: #d9f0cf;\n  font-size: 10px;\n  font-weight: 780;\n}\n\n.decision-summary h3 {\n  margin: 0;\n  font-family: \"Songti SC\", \"STSong\", ui-serif, serif;\n  font-size: 19px;\n  line-height: 1.32;\n  letter-spacing: 0.01em;\n}\n\n.decision-summary p {\n  margin: 0;\n  color: rgba(255, 253, 248, 0.78);\n  font-size: 11px;\n  line-height: 1.72;\n}\n\n.decision-summary-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 10px;\n}\n\n.decision-summary-grid div {\n  display: grid;\n  gap: 5px;\n  padding: 10px 11px;\n  border: 1px solid rgba(255, 255, 255, 0.08);\n  border-radius: 12px;\n  background: rgba(255, 255, 255, 0.04);\n}\n\n.decision-summary-grid span {\n  color: rgba(255, 253, 248, 0.55);\n  font-size: 9px;\n  letter-spacing: 0.04em;\n}\n\n.decision-summary-grid strong {\n  color: #fffdf8;\n  font-size: 11px;\n  line-height: 1.55;\n}\n\n.insight-section + .insight-section {\n  margin-top: 24px;\n}\n\n.insight-section-title {\n  display: flex;\n  align-items: center;\n  gap: 9px;\n  margin-bottom: 11px;\n}\n\n.insight-section-icon {\n  display: grid;\n  width: 34px;\n  height: 34px;\n  flex: 0 0 auto;\n  place-items: center;\n  color: var(--forest-700);\n  border-radius: 10px;\n  background: var(--forest-100);\n}\n\n.insight-section-icon.source-icon {\n  color: #8a6325;\n  background: var(--saffron-soft);\n}\n\n.insight-section-title h3 {\n  margin: 0;\n  font-size: 11px;\n}\n\n.insight-section-title p {\n  margin: 2px 0 0;\n  color: var(--ink-faint);\n  font-size: 8px;\n}\n\n.guardrail-cards,\n.source-cards {\n  display: grid;\n  gap: 8px;\n}\n\n.guardrail-banner {\n  display: flex;\n  align-items: center;\n  gap: 7px;\n  padding: 9px 11px;\n  margin-bottom: 8px;\n  border-radius: 10px;\n  font-size: 11.5px;\n  font-weight: 700;\n}\n\n.guardrail-banner.pass {\n  color: #2f6b43;\n  background: #e8f2e9;\n  border: 1px solid #cfe4d2;\n}\n\n.guardrail-banner.warn {\n  color: #a8402e;\n  background: #faeae6;\n  border: 1px solid #f0d2c9;\n}\n\n.guardrail-banner.adjusted {\n  color: #8a6325;\n  background: #faf3dd;\n  border: 1px solid #ecdcb2;\n}\n\n/* 过敏原硬拦截：比 warn 更重的红色，语义是\"已拒绝输出\"而非\"需注意\" */\n.guardrail-banner.blocked {\n  color: #8f1d1d;\n  background: #fbe4e4;\n  border: 1px solid #f0bfbf;\n}\n\n.guardrail-card strong {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n}\n\n.guardrail-empty {\n  margin: 8px 0 0;\n  font-size: 10.5px;\n  line-height: 1.6;\n  color: rgba(13, 27, 42, 0.45);\n}\n\n.guardrail-card {\n  padding: 11px 12px;\n  border: 1px solid var(--line);\n  border-left: 3px solid #6ea47b;\n  border-radius: 11px;\n  background: rgba(255, 253, 248, 0.8);\n}\n\n.guardrail-card.warn {\n  border-left-color: var(--danger);\n  background: #faf0ed;\n}\n\n.guardrail-card.adjusted {\n  border-left-color: var(--saffron);\n  background: #fbf6e9;\n}\n\n/* 过敏原硬拦截卡片：左描边用危险红，和\"已调整\"的琥珀色明确区分开 */\n.guardrail-card.blocked {\n  border-left-color: #b3261e;\n  background: #fbebeb;\n}\n\n.guardrail-card header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n}\n\n.guardrail-card strong {\n  font-size: 10px;\n}\n\n.guardrail-card header span {\n  padding: 3px 6px;\n  color: var(--forest-700);\n  background: var(--forest-100);\n  border-radius: 999px;\n  font-size: 7px;\n  font-weight: 800;\n}\n\n.guardrail-card.warn header span {\n  color: var(--danger);\n  background: var(--danger-soft);\n}\n\n.guardrail-card.adjusted header span {\n  color: #8a6325;\n  background: var(--saffron-soft);\n}\n\n.guardrail-card p {\n  margin: 7px 0 0;\n  color: var(--ink);\n  font-size: 9px;\n  line-height: 1.55;\n}\n\n.guardrail-card small {\n  display: block;\n  margin-top: 5px;\n  color: var(--ink-faint);\n  font-size: 8px;\n  line-height: 1.5;\n}\n\n.source-card {\n  padding: 12px;\n  border: 1px solid var(--line);\n  border-radius: 11px;\n  background: rgba(255, 253, 248, 0.8);\n}\n\n.source-card > span {\n  display: inline-block;\n  margin-bottom: 6px;\n  padding: 3px 6px;\n  color: #7a5c2b;\n  background: var(--saffron-soft);\n  border-radius: 999px;\n  font-size: 7px;\n}\n\n.source-card h4 {\n  margin: 0;\n  color: var(--forest-800);\n  font-size: 10px;\n  line-height: 1.45;\n}\n\n.source-card p {\n  margin: 6px 0 0;\n  color: var(--ink-soft);\n  font-size: 8px;\n  line-height: 1.6;\n}\n\n.insight-empty-line {\n  display: flex;\n  align-items: center;\n  gap: 7px;\n  padding: 11px 12px;\n  color: var(--forest-700);\n  border: 1px dashed rgba(45, 104, 77, 0.22);\n  border-radius: 10px;\n  background: rgba(227, 238, 230, 0.6);\n  font-size: 8px;\n}\n\